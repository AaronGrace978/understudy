# Default: no accounts or paid services required.
PORT=3000
TWITCH_CHANNEL=
TWITCH_BOT_USERNAME=
# Bot user OAuth token with chat:read and chat:edit scopes. Never share this token.
TWITCH_OAUTH_TOKEN=
# Optional free local model, e.g. Ollama's OpenAI-compatible endpoint.
# Only enable when your local model server is running.
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=llama3.2
# Optional paid OpenAI calls: only used when explicitly selected / invoked in UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
